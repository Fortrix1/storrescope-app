{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/analyse.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/analyse", "dest": "/api/analyse.js" },
    { "src": "/about", "dest": "/public/about.html" },
    { "src": "/about.html", "dest": "/public/about.html" },
    { "src": "/", "dest": "/public/index.html" }
  ]
}
